secret_key: 'random-secret-key'
concurrent: 3
storage: /storage
database: postgresql+psycopg2://postgres:postgres@192.168.1.2:5432/jindai

# 报表 / 锁 / 导入状态 / 回收站审计清单的落点（jindai/paths.py::REPORTS）。
# 不写就用历史默认 <项目根>/batch_operation/reports；写则必须是绝对路径。
# 迁移前请先搬走人工维护的 import_skip.txt / import_defer.txt，并同步改监控 grep 的日志路径。
# import_reports_dir: /app/var/reports

plugins:
- '*'

oidc_secrets: 'oidc-secrets.json'

redis:
  host: localhost
  port: 6379
  db: 0

# Embedding configuration - OpenAI-compatible API
embedding_api_base: 'http://localhost:1234/v1'
embedding_api_key: ''
embedding_model: 'bge-m3'
embedding_dims: 1024

ui_dist: ./dist/
paddle_remote: http://paddle-ocr:8080/

# CORS configuration - list of allowed origins (use "*" to allow all)
cors_origins:
  - "*"

# Bibliography plugin configuration
# BibliographyPlugin:
#   # Base directory under the storage root for uploaded/relocated PDFs:
#   # OneDrive/ -> /storage/OneDrive/ inside the container.
#   upload_base_dir: OneDrive
#   calibre_library_paths:
#     - /path/to/calibre/library1
#     - /path/to/calibre/library2
#   zotero_api_key: your_zotero_api_key_here
#   zotero_library_id: your_zotero_library_id_here
#   zotero_library_type: user  # or 'group' for group libraries
